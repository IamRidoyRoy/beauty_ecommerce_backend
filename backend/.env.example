DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgresql://beauty:beauty@db:5432/beauty
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://admin.example.com
DEFAULT_FROM_EMAIL=no-reply@example.com
SMS_BACKEND=your_project.integrations.sms.Provider

# Existing-customer JWT bypass is intentionally development-only.
# config/settings/development.py enables it; production.py always disables it.

# Payment callbacks must be publicly reachable HTTPS URLs in production.
PAYMENT_API_BASE_URL=https://api.example.com
PAYMENT_STOREFRONT_URL=https://shop.example.com
PAYMENT_GATEWAY_TIMEOUT=20
# Production: generate a stable Fernet key and keep it outside source control.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# SSLCOMMERZ
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# bKash Tokenized / URL Checkout
BKASH_SANDBOX=true
# Optional override when bKash provides a merchant-specific/version-specific base URL.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Online PG
NAGAD_SANDBOX=true
# Keep this override aligned with the exact environment URL supplied by Nagad during onboarding.
NAGAD_BASE_URL=https://sandboxapi.nagad.com.bd/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM text or base64 body is accepted. For Docker env files use literal \n for line breaks.
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_GATEWAY_PUBLIC_KEY=
# Nagad commonly requires merchant server IP/domain whitelisting.
NAGAD_CLIENT_IP=
NAGAD_API_VERSION=v-0.2.0
NAGAD_CLIENT_TYPE=PC_WEB
NAGAD_CURRENCY_CODE=050

# Courier dashboard configuration
COURIER_CONFIG_ENCRYPTION_KEY=
COURIER_API_TIMEOUT=20
